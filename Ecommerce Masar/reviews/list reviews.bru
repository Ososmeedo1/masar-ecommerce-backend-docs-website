meta {
  name: list reviews
  type: http
  seq: 2
}

get {
  url: {{url}}/reviews
  body: none
  auth: inherit
}

headers {
  token: osama{{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: Get user's reviews
  description: '''
    This endpoint gets all reviews.
      
    It uses ApiFeatures when implemented in the list flow, so it can support:
      
    pagination
    filtering by product or user
    sorting by rating
    searching review text
    Examples:
      
    GET /reviews?page=1&limit=10
    GET /reviews?productId=123
    GET /reviews?sort=-reviewRating
    Simple meaning: this API is used to show customer reviews with filtering and sorting.
  '''
  
  request: {
    url: {{url}}/reviews
    method: GET
    mode: none
    headers: {
      token: {{token}}
    }
  }
  
  response: {
    headers: {
      x-powered-by: Express
      access-control-allow-origin: *
      content-type: application/json; charset=utf-8
      content-length: 282
      etag: W/"11a-DvwLPhQ+N9o5h8XRbVbA2p/s9E0"
      date: Sat, 03 Oct 2026 20:04:53 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "done",
          "data": [
            {
              "_id": "6ac15fd433488f956288a309",
              "userId": {
                "email": "username@gmail.com"
              },
              "productId": {
                "title": "Hatif Nokhba 5G"
              },
              "reviewRating": 2,
              "reviewBody": "test",
              "reviewStatus": "pending",
              "createdAt": "2026-10-03T20:04:36.359Z",
              "updatedAt": "2026-10-03T20:04:36.359Z"
            }
          ]
        }
      '''
    }
  }
}
