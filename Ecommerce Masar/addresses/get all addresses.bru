meta {
  name: get all addresses
  type: http
  seq: 4
}

get {
  url: {{url}}/addresses
  body: none
  auth: inherit
}

headers {
  token: osama{{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: Get addresses recorded by a specific user
  description: '''
    This endpoint gets all saved addresses of the logged-in user.
      
    It returns the user’s address list
    It can show the default and other addresses
    Simple meaning: this API is used to view the user’s saved addresses.
  '''
  
  request: {
    url: {{url}}/addresses
    method: GET
    mode: none
    headers: {
      token: {{token}}
    }
  }
  
  response: {
    headers: {
