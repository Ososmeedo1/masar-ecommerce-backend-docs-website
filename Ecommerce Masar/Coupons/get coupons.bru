meta {
  name: get coupons
  type: http
  seq: 1
}

get {
  url: {{url}}/coupons/?isEnabled=true
  body: none
  auth: inherit
}

params:query {
  isEnabled: true
}

headers {
  token: osama{{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: Get coupons
  description: '''
    This endpoint gets all available coupons.
      
    It uses ApiFeatures, so it supports:
      
    pagination
    filtering
    sorting
    searching
    Examples:
      
    GET /coupons?page=1&limit=10
    GET /coupons?search=summer
    GET /coupons?sort=-discount
    Simple meaning: this API is used to show coupon offers to users.
  '''
  
  request: {
    url: {{url}}/coupons/?isEnabled=true
    method: GET
    mode: none
    params:query: {
      isEnabled: true
    }
  
    headers: {
      token: {{token}}
    }
  }
  
  response: {
    headers: {
      x-powered-by: Express
      access-control-allow-origin: *
      content-type: application/json; charset=utf-8
      content-length: 46
      etag: W/"2e-ct45l8zM0RS3R2UsS1iYUfPqK/8"
      date: Sat, 03 Oct 2026 20:01:04 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "Coupons does not exist",
          "data": []
        }
      '''
    }
  }
}
