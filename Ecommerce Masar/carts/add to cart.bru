meta {
  name: add to cart
  type: http
  seq: 1
}

post {
  url: {{url}}/carts/add/6ac11435957e9db5eb78a2b1
  body: json
  auth: inherit
}

headers {
  token: osama{{token}}
}

body:json {
  {
    "quantity": 1
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: Adding product to cart
  description: '''
    This endpoint adds a product to the cart.
      
    It checks the product and user
    It adds the item to the cart
    It may update quantity if already exists
    Simple meaning: this API is used when a user adds an item to the cart.
  '''
  
  request: {
    url: {{url}}/carts/add/6ac11435957e9db5eb78a2b1
    method: POST
    mode: json
    headers: {
      token: {{token}}
    }
  
    body:json: {
      {
        "quantity": 1
      }
    }
  }
  
  response: {
    headers: {
      x-powered-by: Express
      access-control-allow-origin: *
