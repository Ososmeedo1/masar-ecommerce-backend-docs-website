meta {
  name: Update account
  type: http
  seq: 2
}

put {
  url: {{url}}/users/update
  body: json
  auth: inherit
}

headers {
  token: osama{{token}}
}

body:json {
  {
    "username": "Example123#"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: Update Account
  description: '''
    This endpoint updates the logged-in user’s information.
      
    It can update password, email, username, phone, and other account fields
    It can also update the default address
    Simple meaning: this API is used when a user edits their profile.
  '''
  
  request: {
    url: {{url}}/users/update
    method: PUT
    mode: json
    headers: {
      token: {{token}}
    }
  
    body:json: {
      {
        "username": "Example123#"
      }
    }
  }
  
  response: {
    headers: {
      x-powered-by: Express
      access-control-allow-origin: *
      content-type: application/json; charset=utf-8
      content-length: 35
      etag: W/"23-SB6bd/JFSSebU5Ep0vMXK6woT3Q"
      date: Sat, 03 Oct 2026 20:39:26 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "message": "data has been updated"
        }
      '''
    }
  }
}
