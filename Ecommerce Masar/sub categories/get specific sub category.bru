meta {
  name: get specific sub category
  type: http
  seq: 1
}

get {
  url: {{url}}/subcategories/specific?name=Mobiles
  body: none
  auth: inherit
}

params:query {
  name: Mobiles
}

headers {
  token: osama{{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: Get Specific Sub-Category
  description: '''
    This endpoint gets one specific sub-category from the database.
      
    You can search by sub-category id, name, or slug
    It returns the matching sub-category if it exists
    If the sub-category is not found, it returns an error
    In simple words: this API is used when you want to view one sub-category only, such as a single sub-category by its ID or name.
  '''
  
  request: {
    url: {{url}}/subcategories/specific?name=Mobiles
    method: GET
    mode: none
    params:query: {
      name: Mobiles
    }
  
    headers: {
      token: {{token}}
    }
  }
  
  response: {
    headers: {
      x-powered-by: Express
      access-control-allow-origin: *
      content-type: application/json; charset=utf-8
